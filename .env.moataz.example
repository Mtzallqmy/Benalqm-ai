# moataz ai local deployment overlay
# Copy to .env.moataz and fill values. Do not commit the real file.

# UI entry point. 127.0.0.1 = local machine only; 0.0.0.0 = LAN access.
BIND_HOST=127.0.0.1
PORT=2026

# Generate once:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
MOATAZ_PROVIDER_MASTER_KEY=REPLACE_WITH_A_RANDOM_48_BYTE_OR_LONGER_SECRET

# hosted blocks private/loopback provider URLs; local explicitly allows host/LAN endpoints.
MOATAZ_PROVIDER_NETWORK_POLICY=local

# Reproducible product-layer crypto dependency installed by backend/Dockerfile.
MOATAZ_CRYPTOGRAPHY_VERSION=50.0.1

# Android/TWA Digital Asset Links. The SHA-256 certificate fingerprint is public metadata,
# not the signing private key. Leave blank until a release signing certificate is chosen.
MOATAZ_ANDROID_PACKAGE_NAME=ai.moataz.app
MOATAZ_ANDROID_CERT_SHA256=

# Existing DeerFlow deployment variables still apply and remain intentionally
# named DEER_FLOW_* for upstream compatibility.
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
DEER_FLOW_INTERNAL_AUTH_TOKEN=REPLACE_WITH_RANDOM_SECRET
DEER_FLOW_CONFIG_PATH=../config.yaml
DEER_FLOW_EXTENSIONS_CONFIG_PATH=../extensions_config.json
DEER_FLOW_HOME=../.deer-flow
